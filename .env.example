# EcoStitch Backend Environment Variables (.env.example)
# Copy this file to .env and replace placeholders with your actual credentials

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Secret Key (Bypasses RLS for trusted backend operations)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Storage bucket and table overrides
SUPABASE_STORAGE_BUCKET=garment-images
SUPABASE_GARMENTS_TABLE=garments

# Server configuration
PORT=8000
HOST=0.0.0.0
